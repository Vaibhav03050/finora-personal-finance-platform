# Copy this file to .env and adjust as needed.
# Every value below has a safe default in app/config.py, so the app runs
# with zero configuration for local development.

# --- Database ---
# SQLite by default (zero setup). For Docker Compose this is set automatically
# to a path inside the persistent volume.
DATABASE_URL=sqlite:///./finora.db

# --- Auth (REQUIRED to change before any real deployment) ---
FIN_JWT_SECRET=change-me-to-a-long-random-string-in-production
FIN_JWT_ALGORITHM=HS256
FIN_JWT_EXPIRE_MINUTES=30

# --- AI Provider (OPTIONAL) ---
# Leave FIN_AI_PROVIDER=none / FIN_AI_API_KEY empty to run entirely on the
# deterministic fallback (no cost, no external calls, still fully functional).
# To enable a real LLM for the AI Money Coach, set:
#   FIN_AI_PROVIDER=openai
#   FIN_AI_API_KEY=sk-...
#   FIN_AI_BASE_URL=https://api.openai.com/v1
#   FIN_AI_MODEL=gpt-4o-mini
FIN_AI_PROVIDER=none
FIN_AI_API_KEY=
FIN_AI_BASE_URL=https://api.openai.com/v1
FIN_AI_MODEL=gpt-4o-mini

# --- OCR ---
FIN_OCR_ENGINE=tesseract

# --- CORS ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
